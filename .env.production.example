# Copy to .env.production and fill in. Never commit the copy.
# Make each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# The Postgres owner's password; used only by the migration step.
POSTGRES_PASSWORD=
# The application role's password (prismatic_app).
PRISMATIC_APP_PASSWORD=
# Encrypts the two-step secrets at rest. Do not change it once people use 2FA.
PRISMATIC_SECRET=
# The public address, with https. Passkeys are bound to it.
PRISMATIC_URL=https://prismatic.example.dk
# "open" lets more than the first person create an account.
PRISMATIC_SIGNUP=
