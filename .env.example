# Copy to .env. The defaults match docker-compose.dev.yml and are for a
# development machine only.

# The database owner: runs migrations.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/prismatic
# The application's own role, subject to row-level security.
APP_DATABASE_URL=postgres://prismatic_app:prismatic_app@127.0.0.1:5433/prismatic
# The password migrations give prismatic_app; must match APP_DATABASE_URL.
PRISMATIC_APP_PASSWORD=prismatic_app

# Set to "open" to let more than the first person create an account.
# PRISMATIC_SIGNUP=open
